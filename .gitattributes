# Normalize line endings for all text files
* text=auto eol=lf

# Force LF for source code
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.svg   text eol=lf
